@misc{yang2026graphmas,
  abbr        = {Preprint},
  title       = {GraphMAS: A Systematic Benchmark of Multi-Agent Coordination for Graph Learning},
  author      = {Yang, Jiayi and Chen, Yifang and Sun, Yuanfu and Ge, Xinyan and Tan, Qiaoyu},
  note        = {Under review at ICLR 2027},
  year        = {2026},
  arxiv       = {2609.39777},
  abstract    = {We present GraphMAS, a systematic framework and benchmark for multi-agent graph learning that studies when specialized LLM agents benefit from complementary structural and semantic graph perspectives, and how their coordination should be designed. Spanning four coordination paradigms and seven representative methods across node classification and link prediction on seven graphs, we find that gains arise primarily from specialist complementarity and structured reasoning decomposition rather than from increased communication alone. We further propose instance-adaptive routing, which achieves the strongest accuracy–efficiency trade-off among training-free methods, and optimize the coordination policy with PPO over frozen specialists, with transfer to held-out graphs.},
  bibtex_show = {true},
  selected    = {true}
}

@inproceedings{yang2026omgvlm,
  abbr        = {EMNLP},
  title       = {One Model, Many Graphs: Learning over Attributed Graphs across Heterogeneous Modalities with Vision-Language Models},
  author      = {Yang*, Jiayi and Chen*, Yifang and Sun, Yuanfu and Liu, Jiajin and Tan, Qiaoyu},
  booktitle   = {Proceedings of the 2026 Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  year        = {2026},
  arxiv       = {2607.19128},
  code        = {https://github.com/Jo-eyang/OMG-VLM},
  note        = {* Equal contribution},
  abstract    = {We introduce unified attributed graph learning under heterogeneous modality schemas, enabling a single model to operate across text-attributed, image-attributed, and multimodal graphs. Our framework, OMG-VLM, leverages a pretrained vision-language model as a shared backbone and incorporates graph neighborhoods through target-aware textual aggregation and graph-aware visual representation learning within the VLM's native embedding space, eliminating the need for separate modality-specific architectures. Across nine graph benchmarks, OMG-VLM outperforms the strongest GNN-, LLM-, and multimodal baselines by 3.38 points on in-domain graphs and 15.09 points on unseen graphs, with gains of up to 20.15 points under cross-graph transfer.},
  bibtex_show = {true},
  selected    = {true}
}
